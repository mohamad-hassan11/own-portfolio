flowchart LR
    subgraph Desktop["Windows desktop"]
        WPF["WPF client<br/>C#"] -->|"starts process"| DesktopYtDlp["yt-dlp"]
        DesktopYtDlp --> DesktopFFmpeg["FFmpeg"]
        DesktopFFmpeg --> Folder["Selected output folder<br/>MP3 or MP4"]
    end

    subgraph Web["Web application"]
        Browser["Browser<br/>Next.js UI"] -->|"same-origin /api"| Rewrite["Next.js rewrite"]
        Rewrite -->|"Compose service name: api:8000"| API["FastAPI"]
        API -->|"FastAPI BackgroundTasks"| WebYtDlp["yt-dlp"]
        WebYtDlp --> WebFFmpeg["FFmpeg"]
        WebFFmpeg --> Temp["Per-job temporary file"]
        WebYtDlp -->|"progress hooks"| Jobs["In-memory job registry"]
        Jobs -->|"status polling"| Browser
        Temp -->|"GET /api/jobs/{id}/file"| Browser
    end

    subgraph Hosting["Self-hosted deployment"]
        Public["Internet / browser"] --> Domain["Custom domain"]
        Domain --> Cloudflare["Cloudflare"]
        Cloudflare --> Tunnel["Cloudflare Tunnel"]
        Tunnel --> Cloudflared["cloudflared on Linux Mint laptop"]
        Cloudflared -->|"host-local 127.0.0.1:3000"| WebContainer["Next.js container"]
        WebContainer -->|"Docker Compose network"| APIContainer["FastAPI container"]
        APIContainer --> Engine["yt-dlp + FFmpeg"]
    end

    classDef client fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    classDef service fill:#ecfdf5,stroke:#15803d,stroke-width:2px
    classDef media fill:#fff7ed,stroke:#d97706,stroke-width:2px
    class Browser,WPF,Folder,Public,Domain client
    class Rewrite,API,Jobs,WebContainer,APIContainer,Cloudflared,Tunnel,Cloudflare service
    class DesktopYtDlp,DesktopFFmpeg,WebYtDlp,WebFFmpeg,Temp,Engine media
